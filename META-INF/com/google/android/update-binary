#!/bin/sh
OUTFD=$2
ZIPFILE=$3

ui_print() {
    if [ -n "$OUTFD" ] && [ -e "/proc/self/fd/$OUTFD" ]; then
        echo "ui_print $1" > "/proc/self/fd/$OUTFD"
        echo "ui_print" > "/proc/self/fd/$OUTFD"
    else
        echo "$1"
    fi
}

ui_print "**************************************************"
ui_print "*   Xiaomi Redmi Note 15 Pro 4G (charoite) Fixes *"
ui_print "*              Standalone GSI Fixes v2.0         *"
ui_print "*          Powered by BootFox & Antigravity      *"
ui_print "**************************************************"

MODPATH="/data/adb/modules/charoite_fixes"
rm -rf "$MODPATH"
mkdir -p "$MODPATH"

ui_print "- Extracting module files..."
unzip -o "$ZIPFILE" -x "META-INF/*" -d "$MODPATH"

chmod 755 "$MODPATH/service.sh" "$MODPATH/post-fs-data.sh"
chmod 755 "$MODPATH/system/bin/"*
chmod 644 "$MODPATH/system/lib64/"*
chmod 644 "$MODPATH/system/product/overlay/"*
chmod 644 "$MODPATH/module.prop" "$MODPATH/sepolicy.rule" 2>/dev/null

ui_print "- Installation complete! Reboot to apply all fixes."
exit 0
